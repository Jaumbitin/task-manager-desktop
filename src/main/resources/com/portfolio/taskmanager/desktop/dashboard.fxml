<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.portfolio.taskmanager.desktop.controller.DashboardController" styleClass="dashboard">
 <left>
  <VBox prefWidth="242" minWidth="242" spacing="22" styleClass="sidebar">
   <padding><Insets top="30" right="18" bottom="24" left="18"/></padding>
   <HBox spacing="10" alignment="CENTER_LEFT"><Label text="✓" styleClass="app-mark"/><Label text="Task Manager" styleClass="sidebar-brand"/></HBox>
   <Label text="Meu espaço" styleClass="nav-caption"/>
   <VBox fx:id="navigation" spacing="4">
    <Button text="Todas as tarefas" onAction="#showAll" maxWidth="Infinity" styleClass="nav-button"/>
    <Button text="Pendentes" onAction="#showPending" maxWidth="Infinity" styleClass="nav-button"/>
    <Button text="Em andamento" onAction="#showProgress" maxWidth="Infinity" styleClass="nav-button"/>
    <Button text="Concluídas" onAction="#showCompleted" maxWidth="Infinity" styleClass="nav-button"/>
   </VBox>
   <Region VBox.vgrow="ALWAYS"/>
   <Separator/>
   <VBox spacing="10">
    <Label text="Conta pessoal" styleClass="nav-caption"/>
    <Label fx:id="emailLabel" text="" maxWidth="200" textOverrun="CENTER_ELLIPSIS" styleClass="account-email"/>
    <Button text="Sair" onAction="#logout" styleClass="quiet-button"/>
   </VBox>
  </VBox>
 </left>
 <center>
  <VBox spacing="22">
   <padding><Insets top="38" right="42" bottom="22" left="42"/></padding>
   <HBox alignment="CENTER_LEFT">
    <VBox spacing="8" HBox.hgrow="ALWAYS">
     <Label text="PESSOAL / TAREFAS" styleClass="eyebrow"/>
     <Label fx:id="pageHeading" text="Todas as tarefas" styleClass="page-heading"/>
     <Label fx:id="pageSubtitle" wrapText="true" styleClass="muted"/>
    </VBox>
    <HBox fx:id="actions" spacing="8" alignment="CENTER_RIGHT">
     <Button text="Atualizar" onAction="#reload" styleClass="secondary-button"/>
     <Button text="+  Adicionar tarefa" onAction="#newTask" styleClass="primary-button"/>
    </HBox>
   </HBox>
   <HBox spacing="10" alignment="CENTER_LEFT" styleClass="summary">
    <Label fx:id="totalCount" text="0" styleClass="summary-number"/><Label text="no total" styleClass="muted"/>
    <Separator orientation="VERTICAL"/>
    <Label fx:id="openCount" text="0" styleClass="summary-number"/><Label text="em aberto" styleClass="muted"/>
    <Separator orientation="VERTICAL"/>
    <Label fx:id="completedCount" text="0" styleClass="summary-number"/><Label text="concluídas" styleClass="muted"/>
   </HBox>
   <HBox spacing="12" alignment="CENTER_LEFT">
    <TextField fx:id="search" promptText="Buscar tarefas" accessibleText="Buscar tarefas" HBox.hgrow="ALWAYS"/>
    <ComboBox fx:id="statusFilter" prefWidth="175" accessibleText="Filtrar por status"/>
   </HBox>
   <HBox alignment="CENTER_LEFT">
    <Label fx:id="resultCount" text="0 tarefas" styleClass="field-label"/>
    <Region HBox.hgrow="ALWAYS"/><Label text="Mais recentes" styleClass="small"/>
   </HBox>
   <ListView fx:id="taskList" VBox.vgrow="ALWAYS" styleClass="task-list" accessibleText="Lista de tarefas"/>
   <HBox spacing="10" alignment="CENTER_LEFT" minHeight="24">
    <ProgressIndicator fx:id="progress" prefWidth="18" prefHeight="18" maxWidth="18" maxHeight="18" visible="false" managed="false"/>
    <Label fx:id="message" wrapText="true" styleClass="feedback"/>
   </HBox>
  </VBox>
 </center>
</BorderPane>
