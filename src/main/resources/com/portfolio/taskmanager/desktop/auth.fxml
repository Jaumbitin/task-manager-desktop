<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<HBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.portfolio.taskmanager.desktop.controller.AuthController" styleClass="auth-root">
 <VBox prefWidth="490" minWidth="400" spacing="24" styleClass="brand-panel">
  <padding><Insets top="40" right="46" bottom="40" left="46"/></padding>
  <HBox spacing="10" alignment="CENTER_LEFT"><Label text="✓" styleClass="app-mark"/><Label text="Task Manager" styleClass="sidebar-brand"/></HBox>
  <Region VBox.vgrow="ALWAYS"/>
  <Label text="Um lugar para&#10;organizar o seu dia." styleClass="brand-headline"/>
  <Label text="Anote, acompanhe e conclua suas tarefas." wrapText="true" styleClass="brand-copy"/>
  <VBox spacing="0" styleClass="preview-card">
   <Label text="Minha semana" styleClass="preview-caption"/>
   <Label text="○    Preparar a apresentação" styleClass="preview-item"/>
   <Label text="○    Revisar o projeto" styleClass="preview-item"/>
   <Label text="✓    Organizar os documentos" styleClass="preview-item,preview-done"/>
  </VBox>
  <Region VBox.vgrow="ALWAYS"/>
  <Label text="Seu trabalho, organizado por você." styleClass="brand-footer"/>
 </VBox>
 <VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="auth-content">
  <padding><Insets top="36" right="54" bottom="36" left="54"/></padding>
  <VBox maxWidth="350" spacing="16">
   <Label fx:id="heading" text="Entrar" styleClass="auth-heading"/>
   <Label fx:id="subtitle" text="Acesse sua conta para ver suas tarefas." wrapText="true" styleClass="muted"/>
   <VBox fx:id="form" spacing="12" styleClass="auth-form">
    <Label text="E-mail" labelFor="$email" styleClass="field-label"/>
    <TextField fx:id="email" promptText="voce@exemplo.com" onAction="#submit"/>
    <Label text="Senha" labelFor="$password" styleClass="field-label"/>
    <PasswordField fx:id="password" promptText="Sua senha" onAction="#submit"/>
    <VBox fx:id="confirmGroup" spacing="10" visible="false" managed="false">
     <Label text="Confirme a senha" labelFor="$confirmation" styleClass="field-label"/>
     <PasswordField fx:id="confirmation" promptText="Repita sua senha" onAction="#submit"/>
    </VBox>
    <Button fx:id="submit" text="Entrar" onAction="#submit" maxWidth="Infinity" defaultButton="true" styleClass="primary-button,auth-submit"/>
   </VBox>
   <ProgressIndicator fx:id="progress" prefWidth="24" prefHeight="24" visible="false" managed="false"/>
   <Label fx:id="message" wrapText="true" minHeight="36" styleClass="error-text"/>
   <HBox alignment="CENTER_LEFT" spacing="6">
    <Label fx:id="switchPrompt" text="Ainda não tem conta?" styleClass="muted"/>
    <Button fx:id="switchMode" text="Criar conta" onAction="#toggleMode" styleClass="link-button"/>
   </HBox>
  </VBox>
 </VBox>
</HBox>
